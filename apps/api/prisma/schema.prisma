generator client {
  provider      = "prisma-client-js"
  // "native" targets the dev machine (macOS). The linux-musl-openssl-3.0.x
  // target is required for node:20-alpine in Docker -- Prisma's auto-detect
  // guesses OpenSSL 1.1.x on Alpine 3.20+, which no longer ships that lib,
  // and the runtime crashes with "libssl.so.1.1: No such file or directory".
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Brand {
  OWN
  FRAAS
}

enum FamilyAssignmentSource {
  LEXICAL
  SYNONYM
  VISUAL
  MANUAL
}

/// The catalog folder tree. Named "Category" for legacy reasons (retains
/// the model + column names to avoid an app-wide rename); functionally
/// it's a Sortly-style folder that nests. `parentId` is null at the root
/// ("BärHaus (IN STOCK)"). Uniqueness is per-parent so "Scarves" can
/// exist under two different regions if needed. ItemGroups attach to the
/// LEAF folder (whichever level Sortly places the row at).
model Category {
  id             String         @id @default(cuid())
  parentId       String?
  name           String
  sortlyFolder   String?
  itemGroups     ItemGroup[]
  colourFamilies ColourFamily[]
  sizeOptions    SizeOption[]
  createdAt      DateTime       @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  @@unique([parentId, name])
  @@index([parentId])
}

model ItemGroup {
  id           String  @id @default(cuid())
  categoryId   String
  name         String
  squareItemId String? @unique
  brand        Brand   @default(OWN)

  category          Category           @relation(fields: [categoryId], references: [id])
  variations        Variation[]
  warehouseVariants WarehouseVariant[]
  productAttributes ProductAttribute[]

  @@unique([categoryId, name])
}

/// Locally-cached Square catalog item, populated by the sync CLI /
/// endpoint. The mapping modal reads from this cache so operators pick
/// products by name from a dropdown instead of pasting IDs. `lastSyncedAt`
/// lets the UI show a "stale by X hours" indicator. Cascade delete of
/// SquareCatalogVariation via FK — a wiped item takes its variations with it.
model SquareCatalogItem {
  squareItemId String                   @id
  name         String
  categoryName String?
  lastSyncedAt DateTime                 @default(now())
  variations   SquareCatalogVariation[]

  @@index([name])
}

/// Locally-cached Square catalog variation. Every ItemVariation object under
/// every synced Item lives here — including the auto-created "Regular" one
/// on visually-simple items (Dryer Balls). priceCents is captured for the
/// UI's price-drift check (not enforced anywhere else).
model SquareCatalogVariation {
  squareVariationId String            @id
  squareItemId      String
  name              String
  priceCents        Int?
  lastSyncedAt      DateTime          @default(now())
  item              SquareCatalogItem @relation(fields: [squareItemId], references: [squareItemId], onDelete: Cascade)

  @@index([squareItemId])
  @@index([name])
}

/// A variant axis declared for a specific ItemGroup. Each product carries as
/// many of these as it needs — Earmuffs has just Color; Scarves has Style +
/// Color + Size; Dryer Balls has none. `name` is a free-form string so
/// operators can invent axes like "Yarn count" or "Weight" without a schema
/// change. `displayOrder` controls the modal's rendering order.
model ProductAttribute {
  id           String  @id @default(cuid())
  itemGroupId  String
  name         String
  displayOrder Int     @default(0)

  itemGroup ItemGroup               @relation(fields: [itemGroupId], references: [id], onDelete: Cascade)
  values    ProductAttributeValue[]

  @@unique([itemGroupId, name])
  @@index([itemGroupId])
}

/// One legal value on a given axis. "Black" for a Color axis, "Small" for a
/// Size axis, "Broad Stripes" for a Style axis. WarehouseVariants hang off
/// specific values via WarehouseVariantAttribute.
model ProductAttributeValue {
  id                 String @id @default(cuid())
  productAttributeId String
  value              String
  displayOrder       Int    @default(0)

  productAttribute ProductAttribute            @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)
  variantLinks     WarehouseVariantAttribute[]

  @@unique([productAttributeId, value])
  @@index([productAttributeId])
}

/// Join between a stock SKU and one of its attribute values. A WarehouseVariant
/// with three axes (Style + Color + Size) has three rows here. A SKU with no
/// axes (Dryer Balls Set of 3) has zero. This is the model that lets one code
/// path handle products with wildly different variant structures.
model WarehouseVariantAttribute {
  warehouseVariantId      String
  productAttributeValueId String

  warehouseVariant      WarehouseVariant      @relation(fields: [warehouseVariantId], references: [id], onDelete: Cascade)
  productAttributeValue ProductAttributeValue @relation(fields: [productAttributeValueId], references: [id], onDelete: Cascade)

  @@id([warehouseVariantId, productAttributeValueId])
  @@index([productAttributeValueId])
}

/// Tier 1: what the cashier taps. Becomes a Square variation.
model ColourFamily {
  id           String @id @default(cuid())
  categoryId   String
  name         String
  displayOrder Int    @default(0)

  category   Category        @relation(fields: [categoryId], references: [id])
  variants   ColourVariant[]
  variations Variation[]

  @@unique([categoryId, name])
}

/// Tier 2: warehouse detail. Maps to exactly one family. See spec §6.
model ColourVariant {
  id                     String                 @id @default(cuid())
  colourFamilyId         String
  name                   String
  sortlyName             String?
  normalisedName         String
  /// Archived from Sortly before the subscription lapses. Spec §6.3.
  photoUrl               String?
  familyAssignmentSource FamilyAssignmentSource
  familyConfidence       Float                  @default(0)

  colourFamily      ColourFamily       @relation(fields: [colourFamilyId], references: [id])
  warehouseVariants WarehouseVariant[]

  @@unique([colourFamilyId, name])
  @@index([normalisedName])
}

model SizeOption {
  id           String @id @default(cuid())
  categoryId   String
  name         String
  displayOrder Int    @default(0)

  category          Category           @relation(fields: [categoryId], references: [id])
  variations        Variation[]
  warehouseVariants WarehouseVariant[]

  @@unique([categoryId, name])
}

/// Sellable unit: ItemGroup x ColourFamily x Size.
model Variation {
  id                String  @id @default(cuid())
  itemGroupId       String
  colourFamilyId    String
  sizeOptionId      String
  squareVariationId String? @unique
  isSellable        Boolean @default(true)

  itemGroup         ItemGroup            @relation(fields: [itemGroupId], references: [id])
  colourFamily      ColourFamily         @relation(fields: [colourFamilyId], references: [id])
  sizeOption        SizeOption           @relation(fields: [sizeOptionId], references: [id])
  warehouseVariants WarehouseVariant[]
  thresholds        Threshold[]
  requestLines      RestockRequestLine[]
  ledgerEvents      LedgerEvent[]

  @@unique([itemGroupId, colourFamilyId, sizeOptionId])
}

/// Stock unit: ItemGroup x ColourVariant x Size. Carries the warehouse SKU.
model WarehouseVariant {
  id              String  @id @default(cuid())
  itemGroupId     String
  colourVariantId String
  sizeOptionId    String
  /// Denormalised roll-up from ColourVariant.colourFamilyId. Written at seed
  /// time, maintained on family reassignment. Lets one ledger row carry both
  /// granularities without a join at write time.
  variationId     String
  warehouseSku    String  @unique
  /// Square catalog object id for this specific colour/size SKU. When a POS
  /// sale arrives, the mapper resolves the incoming catalog_object_id against
  /// this field first so the SALE lands on the specific WarehouseVariant
  /// (Earmuffs / Black), not just the family Variation. Variation.squareVariationId
  /// stays as a family-level fallback for products where Square only exposes
  /// one variation per item.
  squareVariationId String? @unique
  unitCostCents   Int?
  isSaleItem      Boolean @default(true)

  /// Every Sortly photo for this row, in file order (Photo1 first). Sortly
  /// URLs are signed tokens that lapse with the subscription -- see
  /// cli:archive-photos for the local copy that survives that. Kept as an
  /// array rather than photo1..photoN columns because Sortly allows up to
  /// eight and only a handful of rows use more than the first.
  photoUrls    String[] @default([])

  itemGroup     ItemGroup             @relation(fields: [itemGroupId], references: [id])
  colourVariant ColourVariant         @relation(fields: [colourVariantId], references: [id])
  sizeOption    SizeOption            @relation(fields: [sizeOptionId], references: [id])
  variation     Variation             @relation(fields: [variationId], references: [id])
  attributes    WarehouseVariantAttribute[]
  boxLines      BoxLine[]
  requestLines  RestockRequestLine[]
  ledgerEvents  LedgerEvent[]

  // Legacy uniqueness on (itemGroupId, colourVariantId, sizeOptionId) was
  // dropped when the flexible attribute model took over — with colour as a
  // placeholder for xlsx-imported rows, that composite collapses genuine
  // per-colour SKUs into one row. warehouseSku is now the per-SKU identity.
  @@index([variationId])
}

enum LocationKind {
  MARKET
  WAREHOUSE
}

enum LedgerEventType {
  INTAKE
  DISPATCH
  SALE
  WRITE_OFF
  RETURN
  CORRECTION
}

enum LedgerSource {
  WEBHOOK
  POLL
  UI
  SCRIPT
}

enum WriteOffReason {
  DAMAGE
  GIFT
  SAMPLE
}

/// The warehouse is a Location. That makes intake, dispatch and season
/// returns the same operation with different endpoints. Spec §5.1.
model Location {
  id               String       @id @default(cuid())
  name             String       @unique
  kind             LocationKind
  /// Null for the warehouse.
  squareLocationId String?      @unique
  timezone         String
  /// Per-market season calendars. Boston opens Nov 7, Denver closes Dec 24.
  seasonStart      DateTime?
  seasonEnd        DateTime?
  isActive         Boolean      @default(true)

  ledgerEvents    LedgerEvent[]
  restockRequests RestockRequest[]
  boxes           Box[]
  loads           Load[]
  thresholds      Threshold[]
  syncCursor      SquareSyncCursor?
  users           User[]

  @@index([kind])
}

/// Append-only. Never updated, never deleted. A mistake is corrected by
/// appending a CORRECTION row. This is what makes recompute-from-zero real.
///
/// Enforced at the database level, not just by convention: the hand-written
/// migration 20260820064642_ledger_append_only adds a BEFORE UPDATE OR
/// DELETE trigger that raises on any attempt to mutate an existing row.
/// `prisma db push` does not know about hand-written migrations and will
/// drop it silently — always use `prisma migrate deploy`/`migrate dev` on
/// this schema, never `db push`.
///
/// Mixed granularity is deliberate (spec §5.5): variationId is ALWAYS set,
/// warehouseVariantId only when known. Sales arrive from Square at family
/// level and therefore carry none.
model LedgerEvent {
  id                 String          @id @default(cuid())
  type               LedgerEventType
  locationId         String
  variationId        String
  warehouseVariantId String?
  /// Signed. Positive adds at this location, negative removes.
  quantity           Int
  occurredAt         DateTime
  recordedAt         DateTime        @default(now())
  source             LedgerSource
  sourceRef          String?
  /// Makes replay and re-ingestion safe.
  idempotencyKey     String          @unique
  /// No relation on purpose: ledger rows must survive a user being deleted,
  /// and a required User relation would either block that deletion or
  /// cascade into the event log. Do not "fix" this into a relation.
  actorId            String?
  /// Links the two rows of a transfer: negative at source, positive at destination.
  transferId         String?
  reason             WriteOffReason?
  note               String?

  location         Location          @relation(fields: [locationId], references: [id])
  /// A Variation with ledger history must be exactly as undeletable as it
  /// would otherwise be: RESTRICT is a clean FK violation, never an UPDATE
  /// against LedgerEvent, so it never touches the append-only trigger.
  variation        Variation         @relation(fields: [variationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Deliberately RESTRICT, not the SET NULL Prisma would default to for an
  /// optional relation. SET NULL is implemented by Postgres as an UPDATE
  /// against the child row, which fires the append-only trigger (it has no
  /// WHEN clause excluding FK-originated updates) and raises. That means a
  /// delete would today only be blocked as a side effect of a mechanism
  /// meant for something else — undocumented, fragile, and if it ever did
  /// succeed it would silently null out the field that distinguishes a
  /// variant-level movement from a family-level one, permanently and
  /// invisibly, since append-only forbids fixing it in place. RESTRICT
  /// makes a WarehouseVariant with ledger history fail the same clean way a
  /// Variation with ledger history does.
  warehouseVariant WarehouseVariant? @relation(fields: [warehouseVariantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([variationId, locationId])
  @@index([warehouseVariantId, locationId])
  @@index([locationId, occurredAt])
  @@index([transferId])
}

enum RequestState {
  DRAFT
  OPEN
  PACKING
  DISPATCHED
  ARRIVED
  CLOSED
}

enum RequestOrigin {
  THRESHOLD
  REVIEW
  MANUAL
}

enum BoxState {
  PACKING
  DISPATCHED
  ARRIVED
  RETURNED
}

enum ThresholdSource {
  SEEDED
  MANUAL
}

enum UserRole {
  OWNER
  WAREHOUSE_MANAGER
  WAREHOUSE_OPERATOR
  MARKET_MANAGER
  SALES
}

model RestockRequest {
  id          String        @id @default(cuid())
  locationId  String
  state       RequestState  @default(DRAFT)
  createdFrom RequestOrigin
  createdById String?
  createdAt   DateTime      @default(now())
  closedAt    DateTime?

  location  Location             @relation(fields: [locationId], references: [id])
  lines     RestockRequestLine[]
  boxes     Box[]
  /// Per-line back-reference so a single Box can fulfil multiple
  /// requests. When a physical box carries lines from more than one
  /// request, Box.requestId is NULL and each BoxLine.requestId points
  /// back here individually. Box.requestId stays populated for the
  /// common single-request case to keep display code simple.
  boxLines  BoxLine[]

  @@index([locationId, state])
}

model RestockRequestLine {
  id                 String  @id @default(cuid())
  requestId          String
  variationId        String
  warehouseVariantId String?
  qtyRequested       Int

  request          RestockRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// A Variation with ledger history must be exactly as undeletable as it
  /// would otherwise be: RESTRICT is a clean FK violation, never an UPDATE
  /// against LedgerEvent, so it never touches the append-only trigger.
  variation        Variation         @relation(fields: [variationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Deliberately RESTRICT, not the SET NULL Prisma would default to for an
  /// optional relation. SET NULL is implemented by Postgres as an UPDATE
  /// against the child row, which fires the append-only trigger (it has no
  /// WHEN clause excluding FK-originated updates) and raises. That means a
  /// delete would today only be blocked as a side effect of a mechanism
  /// meant for something else — undocumented, fragile, and if it ever did
  /// succeed it would silently null out the field that distinguishes a
  /// variant-level movement from a family-level one, permanently and
  /// invisibly, since append-only forbids fixing it in place. RESTRICT
  /// makes a WarehouseVariant with ledger history fail the same clean way a
  /// Variation with ledger history does.
  warehouseVariant WarehouseVariant? @relation(fields: [warehouseVariantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([requestId])
}

/// The QR label encodes qrToken only. Contents live in BoxLine, so a manifest
/// edited before dispatch never orphans its label. Spec §9.4.
model Box {
  id                    String    @id @default(cuid())
  requestId             String?
  destinationLocationId String
  state                 BoxState  @default(PACKING)
  qrToken               String    @unique
  packedById            String?
  packedAt              DateTime?
  dispatchedAt          DateTime?
  arrivedAt             DateTime?

  request             RestockRequest? @relation(fields: [requestId], references: [id])
  destinationLocation Location        @relation(fields: [destinationLocationId], references: [id])
  lines               BoxLine[]
  loadBoxes           LoadBox[]

  @@index([destinationLocationId, state])
}

model BoxLine {
  id                 String  @id @default(cuid())
  boxId              String
  warehouseVariantId String
  /// Which RestockRequest this line fulfils. Nullable for "loose" boxes
  /// packed without a request. Multi-request boxes carry a mix of
  /// requestIds across their lines; single-request boxes typically all
  /// share one, mirroring Box.requestId. RESTRICT matches the pattern
  /// on RestockRequestLine — a Request with box history must not be
  /// silently deletable.
  requestId          String?
  quantity           Int

  box              Box              @relation(fields: [boxId], references: [id], onDelete: Cascade)
  warehouseVariant WarehouseVariant @relation(fields: [warehouseVariantId], references: [id])
  request          RestockRequest?  @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([boxId])
  @@index([requestId])
}

model Load {
  id                    String    @id @default(cuid())
  vehicleLabel          String
  destinationLocationId String
  createdById           String?
  createdAt             DateTime  @default(now())
  dispatchedAt          DateTime?

  destinationLocation Location  @relation(fields: [destinationLocationId], references: [id])
  boxes               LoadBox[]
}

model LoadBox {
  loadId    String
  boxId     String
  scannedAt DateTime @default(now())

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)
  box  Box  @relation(fields: [boxId], references: [id])

  @@id([loadId, boxId])
}

model Threshold {
  id          String          @id @default(cuid())
  variationId String
  locationId  String
  minLevel    Int
  source      ThresholdSource @default(SEEDED)
  updatedById String?
  updatedAt   DateTime        @updatedAt

  variation Variation @relation(fields: [variationId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])

  @@unique([variationId, locationId])
}

/// Not optional. Both sides can edit a request before packing, and every edit
/// records who, when, and old to new. Spec §5.7.
model AuditLog {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  field    String
  oldValue String?
  newValue String?
  actorId  String?
  at       DateTime @default(now())

  @@index([entity, entityId])
}

/// Raw inbound Square payloads. The webhook endpoint writes here and returns
/// 200; a worker processes later. Spec §7.1.
model SquareInboxEvent {
  id            String    @id @default(cuid())
  squareEventId String    @unique
  eventType     String
  payload       Json
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  error         String?

  @@index([processedAt])
}

model SquareSyncCursor {
  locationId   String    @id
  lastPolledAt DateTime?
  cursor       String?

  location Location @relation(fields: [locationId], references: [id])
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String
  role     UserRole
  isActive Boolean  @default(true)
  /// Only meaningful for MARKET_MANAGER: scopes them to one location. Null
  /// for the other three roles, which see everything.
  locationId String?
  /// Argon2id hash (@node-rs/argon2). Nullable so the migration adding this
  /// column applies cleanly to existing rows; cli:seed-users backfills it.
  /// A null passwordHash cannot log in -- see AuthService.login.
  passwordHash String?

  location Location? @relation(fields: [locationId], references: [id])
  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
