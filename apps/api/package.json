{
  "name": "@winterborn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "lint": "echo lint-ok",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "cli:import-sortly": "tsx src/cli/import-sortly.ts",
    "cli:assign-families": "tsx src/cli/assign-families.ts",
    "cli:archive-photos": "tsx src/cli/archive-photos.ts",
    "cli:generate-skus": "tsx src/cli/generate-skus.ts",
    "cli:join-square": "tsx src/cli/join-square.ts",
    "cli:catalog-preflight": "tsx src/cli/catalog-preflight.ts",
    "cli:catalog-backup": "tsx src/cli/catalog-backup.ts",
    "cli:catalog-plan": "tsx src/cli/catalog-plan.ts",
    "cli:catalog-apply": "tsx src/cli/catalog-apply.ts",
    "cli:catalog-verify": "tsx src/cli/catalog-verify.ts",
    "cli:catalog-migrate": "tsx src/cli/catalog-migrate.ts",
    "cli:catalog-rollback": "tsx src/cli/catalog-rollback.ts",
    "cli:poll-orders": "tsx src/cli/poll-orders.ts",
    "cli:drain-inbox": "tsx src/cli/drain-inbox.ts",
    "cli:replay-season": "tsx src/cli/replay-season.ts",
    "cli:seed-users": "tsx src/cli/seed-users.ts",
    "cli:seed-locations": "tsx src/cli/seed-locations.ts",
    "cli:seed-thresholds": "tsx src/cli/seed-thresholds.ts",
    "cli:migrate-to-flexible-attributes": "tsx src/cli/migrate-to-flexible-attributes.ts",
    "cli:migrate-warehouse-skus": "tsx src/cli/migrate-warehouse-skus.ts",
    "cli:fix-audit-sources": "tsx src/cli/fix-audit-sources.ts",
    "cli:backfill-square-sales": "tsx src/cli/backfill-square-sales.ts",
    "cli:auto-map-square-catalog": "tsx src/cli/auto-map-square-catalog.ts",
    "cli:seed-fake-sales": "tsx src/cli/seed-fake-sales.ts",
    "cli:seed-suggest-test-data": "tsx src/cli/seed-suggest-test-data.ts",
    "cli:wipe-fake-sales": "tsx src/cli/wipe-fake-sales.ts",
    "cli:import-square-order-csvs": "tsx src/cli/import-square-order-csvs.ts",
    "cli:assign-catalog-prices": "tsx src/cli/assign-catalog-prices.ts",
    "cli:sync-square-catalog": "tsx src/cli/sync-square-catalog.ts",
    "cli:reset-db-keep-users": "tsx src/cli/reset-db-keep-users.ts",
    "cli:import-sortly-xlsx": "tsx src/cli/import-sortly-xlsx.ts",
    "cli:reset-catalog": "tsx src/cli/reset-catalog.ts",
    "reseed:catalog": "pnpm cli:reset-catalog -- --confirm && pnpm cli:import-sortly-xlsx"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^5.20.0",
    "@winterborn/shared": "workspace:*",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "square": "^43.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^22.0.0",
    "@winterborn/config": "workspace:*",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.0"
  }
}
