{
  "name": "@winterborn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "lint": "echo lint-ok",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "cli:import-sortly": "tsx src/cli/import-sortly.ts",
    "cli:assign-families": "tsx src/cli/assign-families.ts",
    "cli:archive-photos": "tsx src/cli/archive-photos.ts",
    "cli:generate-skus": "tsx src/cli/generate-skus.ts",
    "cli:join-square": "tsx src/cli/join-square.ts",
    "cli:catalog-plan": "tsx src/cli/catalog-plan.ts",
    "cli:catalog-apply": "tsx src/cli/catalog-apply.ts",
    "cli:catalog-verify": "tsx src/cli/catalog-verify.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^5.20.0",
    "@winterborn/shared": "workspace:*",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "square": "^43.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.16.1",
    "@types/node": "^22.0.0",
    "@winterborn/config": "workspace:*",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.0"
  }
}
