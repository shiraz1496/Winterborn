# ---------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must stay that way.
# ---------------------------------------------------------------

# Square -- SANDBOX while building. Swap to production only at cutover.
SQUARE_ENV=sandbox
SQUARE_APPLICATION_ID=sandbox-sq0idb-xxxxxxxxxxxxxxxxxxxxxx
SQUARE_ACCESS_TOKEN=EAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SQUARE_WEBHOOK_SIGNATURE_KEY=          # added when the webhook subscription is created

# Database
DATABASE_URL=postgresql://winterborn:winterborn@localhost:5432/winterborn

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=
MAGIC_LINK_TTL_MINUTES=15

# Email -- console transport until a sending domain is verified
MAIL_TRANSPORT=console
RESEND_API_KEY=
MAIL_FROM=

# App
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
