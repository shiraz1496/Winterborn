# ---------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must stay that way.
# See docs/DEPLOY.md for the full table of where each of these comes
# from in production, which are owner-gated, and the cutover order.
# ---------------------------------------------------------------

# Square -- SANDBOX while building. Swap to production only at cutover
# (an env var change per spec §4.5, not a code change).
SQUARE_ENV=sandbox
SQUARE_APPLICATION_ID=sandbox-sq0idb-xxxxxxxxxxxxxxxxxxxxxx
SQUARE_ACCESS_TOKEN=EAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Added after the webhook subscription is created against this service's
# real public URL (webhook.controller.ts verifies every event against it).
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must byte-for-byte match the URL registered with Square -- the
# signature is HMAC'd over notificationUrl + body, so a mismatch here
# (trailing slash, http vs https) fails every webhook, silently, until
# the reconciliation poll catches up 20 minutes later.
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:3001/square/webhook

# Database
DATABASE_URL=postgresql://winterborn:winterborn@localhost:5432/winterborn

# Redis -- provisioned by docker-compose.yml for local dev, but NOT
# currently consumed by any application code: spec §4.3 describes a
# BullMQ-backed worker queue, and this codebase's worker
# (cli:drain-inbox, apps/api/src/cli/drain-inbox.ts) is a plain interval
# loop instead, not a queue consumer. Keep this here for parity with
# docker-compose and the spec's intended architecture; do not assume
# anything reads it today.
REDIS_URL=redis://localhost:6379

# Auth -- password login (auth.service.ts). The API refuses to boot
# without JWT_SECRET (main.ts) rather than failing on the first login.
JWT_SECRET=            # required; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# App
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# apps/web only, NEXT_PUBLIC_-prefixed so Next.js inlines it into the
# browser bundle at build time -- apps/web/lib/api.ts's only network
# config. Unset locally (defaults to http://localhost:3001); required in
# every deployed environment.
NEXT_PUBLIC_API_URL=http://localhost:3001

# apps/api/src/cli/drain-inbox.ts only -- milliseconds between backlog
# sweeps. Optional; defaults to 10000 (10s) if unset.
INBOX_DRAIN_INTERVAL_MS=10000

# ---------------------------------------------------------------
# Dev-only, not used at runtime by the deployed services above:
# ---------------------------------------------------------------
# cli:seed-users -- assigns the one MARKET_MANAGER seed user to a
# location by name. Unset is fine; the CLI picks the first market.
SEED_MARKET_MANAGER_LOCATION=

# cli:seed-users -- password for each seeded role. Unset falls back to
# SEED_DEFAULT_PASSWORD, then to the literal dev default 'winterborn-dev'.
# The CLI prints the email/password it set for each role on every run --
# an operator resets a password by re-running the seeder with a new
# value here. No password reset flow exists (deliberately, per spec:
# four to six known users on a seasonal team).
SEED_DEFAULT_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_WAREHOUSE_PASSWORD=
SEED_MARKET_MANAGER_PASSWORD=
SEED_OPERATOR_PASSWORD=
