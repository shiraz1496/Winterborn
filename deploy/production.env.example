# ------------------------------------------------------------------
# Production environment for the single-server (Hetzner) deploy.
#
# ON THE SERVER:   cp deploy/production.env.example .env
# then edit .env and replace every CHANGE_ME. Full walkthrough in
# HETZNER-DEPLOY.md (Phase 5).
#
# (Named production.env.example, not .env.production.example, so the
# repo's `.env.*` gitignore rule doesn't swallow it.)
# ------------------------------------------------------------------

NODE_ENV=production
API_PORT=3001

# --- Domains -------------------------------------------------------
# sslip.io is a free service: any hostname ending in
# <ip-with-dashes>.sslip.io resolves to that IP. No signup, nothing to
# configure. If you later buy a real domain, change these two lines
# (plus WEB_ORIGIN and NEXT_PUBLIC_API_URL below), point the domain's
# DNS at the server, and rebuild.
WEB_DOMAIN=app.5-78-224-178.sslip.io
API_DOMAIN=api.5-78-224-178.sslip.io

# --- Database ------------------------------------------------------
# Make up ONE strong password and put the SAME value in both lines.
# Use ONLY letters and numbers (a long random mix is plenty strong) --
# symbols like $ % @ / : break Docker's variable substitution and the
# connection-string format. Generate one with:  openssl rand -hex 24
# `postgres` (the hostname in the URL) is the database container's name
# on the internal Docker network -- leave it as-is.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://winterborn:CHANGE_ME@postgres:5432/winterborn

# --- Auth ----------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# --- URLs ----------------------------------------------------------
# Must be https:// + the exact WEB_DOMAIN value above (the API's CORS
# allow-list).
WEB_ORIGIN=https://app.5-78-224-178.sslip.io
# NEXT_PUBLIC_API_URL must stay UNSET. With it unset, the browser calls
# the same-origin /backend proxy (apps/web/lib/api.ts), which the Next
# server forwards to the API internally (BACKEND_INTERNAL_URL, set in
# docker-compose.prod.yml). One origin = the login session cookie works
# everywhere, including iOS Safari. Setting this would silently break
# iPhone logins -- do not "fix" it.

# --- Square (leave as-is for now; see docs/DEPLOY.md before filling) --
# The API imports its Square client at boot, and that module REFUSES to
# load unless SQUARE_ENV is "sandbox" and SQUARE_APPLICATION_ID starts
# with "sandbox-" (a safety guard in src/catalog/square-client.ts that
# protects the live catalog). Until real credentials exist, these
# placeholder values keep the API booting; only the Square-facing
# features (admin Square sync pages, order polling) will error if used.
SQUARE_ENV=sandbox
SQUARE_APPLICATION_ID=sandbox-placeholder-not-real
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# When you do set this up: must byte-for-byte match the URL registered
# with Square, e.g. https://api.5-78-224-178.sslip.io/square/webhook
SQUARE_WEBHOOK_NOTIFICATION_URL=
INBOX_DRAIN_INTERVAL_MS=10000

# --- Login accounts ------------------------------------------------
# Password given to every account the seed command creates. MUST be set
# before seeding on a live server -- if left blank, accounts get the
# publicly known dev default "winterborn-dev". Letters and numbers only.
# Re-running the seed command with a new value here resets the passwords
# (that is the intended reset mechanism; there is no self-service flow).
SEED_DEFAULT_PASSWORD=CHANGE_ME
